# ── MongoDB Atlas Connection String ───────────────────────
# Get this from: mongodb.com/atlas → Connect → Drivers
# Replace <username>, <password>, and <cluster> with your values
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/shopforge

# ── JWT Secret Key ─────────────────────────────────────────
# Any long random string — keep this private!
JWT_SECRET=shopforge_super_secret_key_change_this_2025

# ── Port ───────────────────────────────────────────────────
PORT=5000
